{
  "_comment": "Default configuration. Every option can be overridden from the CLI (--set key=value) or the web interface.",
  "extractor": "spacy",
  "extractor_fallback": "heuristic",
  "implicit_how_subject": true,
  "cascade": {
    "order": [
      "structure",
      "linguistic",
      "content",
      "terminology"
    ],
    "enabled": [
      "structure",
      "linguistic",
      "content",
      "terminology"
    ],
    "cache": true
  },
  "thresholds": {
    "linguistic": 0.75,
    "content": 0.8,
    "terminology": 0.85
  },
  "structure": {
    "backend": "wordnet",
    "max_hypernym_depth": 6,
    "sparql_endpoint": "http://localhost:9999/blazegraph/namespace/wdq/sparql",
    "taxonomy_file": "",
    "try_modifiers": true
  },
  "linguistic": {
    "ic_corpus": "ic-brown.dat",
    "lexicon_file": "config/lexicon.json"
  },
  "content": {
    "backend": "gensim",
    "vectors": "glove-wiki-gigaword-100",
    "vectors_file": "",
    "sentence_method": "average"
  },
  "corenlp": {
    "url": "http://localhost:9000"
  },
  "adelie": {
    "model": "THU-KEG/ADELIE-SFT-3B",
    "max_new_tokens": 64
  },
  "ollama": {
    "url": "http://localhost:11434",
    "model": "llama3.1"
  },
  "missing_how": "different",
  "rules": {
    "sd_vd_od": "appendix",
    "how_same": "appendix"
  },
  "rules_version": "v1",
  "segmenter": "simple",
  "rules_v2": {
    "abstain": true,
    "margin": 0.03,
    "hier_different": "disjoint"
  }
}